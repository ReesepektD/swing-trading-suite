//@version=5
indicator("QQQ Swing Suite", shorttitle="QQQ-SWING", overlay=true, max_labels_count=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
show_emas   = input.bool(true,  "Show EMAs (21/50)",       group="Moving Averages")
show_smas   = input.bool(true,  "Show SMAs (150/200)",     group="Moving Averages")
show_darvas = input.bool(true,  "Show Darvas Box",         group="Darvas Box")
darvas_len  = input.int(20,     "Darvas Lookback",         group="Darvas Box")
show_vcp    = input.bool(true,  "Show VCP Band",           group="VCP (Minervini)")
vcp_len     = input.int(10,     "VCP Lookback", minval=5,  group="VCP (Minervini)")
show_stage  = input.bool(true,  "Show Stage Shading",      group="Stage Analysis")
show_gamma  = input.bool(true,  "Show Gamma Overlay",      group="Gamma / OpEx")
vix_neg_lvl = input.float(20.0, "Negative Gamma VIX Level",group="Gamma / OpEx", step=0.5)
rsi_len     = input.int(14,     "RSI Length",              group="Oscillators")
rsi_ob      = input.int(70,     "RSI Overbought",          group="Oscillators")
rsi_os      = input.int(40,     "RSI Oversold Floor",      group="Oscillators")
macd_fast   = input.int(12,     "MACD Fast",               group="Oscillators")
macd_slow   = input.int(26,     "MACD Slow",               group="Oscillators")
macd_sig    = input.int(9,      "MACD Signal",             group="Oscillators")
vol_len     = input.int(20,     "Volume MA Length",        group="Volume")
vol_mult    = input.float(1.5,  "Volume Surge Multiplier", group="Volume")
atr_len     = input.int(14,     "ATR Length",              group="Risk")
atr_sl      = input.float(2.0,  "Stop-Loss Multiplier",    group="Risk")
atr_tp      = input.float(3.0,  "Take-Profit Multiplier",  group="Risk")

// ── Colors (defined once) ─────────────────────────────────────────────────────
var c_ok = color.new(color.green, 20)
var c_no = color.new(color.red,   20)
var c_na = color.new(color.gray,  60)
var c_hd = color.new(#1565C0,     10)

// ── Moving Averages ───────────────────────────────────────────────────────────
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)

plot(show_emas ? ema21  : na, "EMA 21",  color=#00E5FF, linewidth=1)
plot(show_emas ? ema50  : na, "EMA 50",  color=#FF9800, linewidth=1)
plot(show_smas ? sma150 : na, "SMA 150", color=#AB47BC, linewidth=1)
plot(show_smas ? sma200 : na, "SMA 200", color=#EF5350, linewidth=2)

// ── Trend Template (Minervini — 7 conditions) ─────────────────────────────────
tt1      = close  > sma200
tt2      = sma200 > sma200[21]
tt3      = sma150 > sma200
tt4      = ema50  > sma150 and ema50 > sma200
tt5      = close  > ema50
tt6      = close  >= ta.lowest(low, 252)  * 1.30
tt7      = close  >= ta.highest(high, 252) * 0.75
tt_score = (tt1?1:0)+(tt2?1:0)+(tt3?1:0)+(tt4?1:0)+(tt5?1:0)+(tt6?1:0)+(tt7?1:0)

// ── Stage Analysis (Weinstein) ────────────────────────────────────────────────
slope  = sma200 - sma200[10]
stage2 = close > sma200 and slope > 0
stage4 = close < sma200 and slope < 0

bgcolor(show_stage and stage2 ? color.new(color.green, 93) : na, title="Stage 2")
bgcolor(show_stage and stage4 ? color.new(color.red,   93) : na, title="Stage 4")

// ── Darvas Box ────────────────────────────────────────────────────────────────
d_top     = ta.highest(high, darvas_len)
d_bot     = ta.lowest(low,   darvas_len)
darvas_bo = close > d_top[1]

plot(show_darvas ? d_top : na, "Darvas Top",    color=color.new(color.yellow, 40), linewidth=1, style=plot.style_stepline)
plot(show_darvas ? d_bot : na, "Darvas Bottom", color=color.new(color.yellow, 40), linewidth=1, style=plot.style_stepline)

// ── VCP — Volatility Contraction (Minervini) ──────────────────────────────────
atr    = ta.atr(atr_len)
vcp_ok = atr < atr[vcp_len] * 0.70

plot(show_vcp and vcp_ok ? ta.highest(high, vcp_len) : na, "VCP Hi", color=color.new(#26C6DA, 55), linewidth=1, style=plot.style_circles)
plot(show_vcp and vcp_ok ? ta.lowest(low,   vcp_len) : na, "VCP Lo", color=color.new(#26C6DA, 55), linewidth=1, style=plot.style_circles)

// ── Oscillators ───────────────────────────────────────────────────────────────
rsi              = ta.rsi(close, rsi_len)
rsi_momentum     = rsi > 50 and rsi < rsi_ob
rsi_pullback     = rsi >= rsi_os and rsi < 55

[macd_l, sig_l, _] = ta.macd(close, macd_fast, macd_slow, macd_sig)
macd_bull        = macd_l > sig_l and macd_l > 0
macd_cross       = ta.crossover(macd_l, sig_l)

// ── Gamma / OpEx ─────────────────────────────────────────────────────────────
vix        = request.security("CBOE:VIX", timeframe.period, close, ignore_invalid_symbol=true)
neg_gamma  = not na(vix) and vix > vix_neg_lvl
is_opex_wk = dayofweek == dayofweek.friday and dayofmonth >= 15 and dayofmonth <= 21
gamma_flip = math.round(close / 5) * 5.0

bgcolor(show_gamma and is_opex_wk ? color.new(color.orange, 88) : na, title="OpEx Week")
plot(show_gamma ? gamma_flip : na, "Gamma Flip ~", color=color.new(color.orange, 50),
     linewidth=1, style=plot.style_circles)

// ── Volume ────────────────────────────────────────────────────────────────────
vol_surge = volume > ta.sma(volume, vol_len) * vol_mult

// ── Signals ───────────────────────────────────────────────────────────────────
entry_mom    = tt_score >= 6 and stage2 and macd_bull and rsi_momentum and vol_surge
entry_darvas = darvas_bo and tt_score >= 5 and vol_surge
entry_vcp    = vcp_ok and tt_score >= 5 and macd_cross and vol_surge
entry_pullbk = tt_score == 7 and stage2 and rsi_pullback and close > ema21 and macd_bull and not vol_surge
exit_signal  = (ta.crossunder(close, ema50) and vol_surge) or stage4

// ── Labels ────────────────────────────────────────────────────────────────────
if entry_mom or entry_darvas or entry_vcp
    txt = entry_mom ? "ENTRY  Momentum" : entry_darvas ? "ENTRY  Darvas BO" : "ENTRY  VCP"
    label.new(bar_index, low * 0.995, txt, style=label.style_label_up,
              color=color.new(color.lime, 10), textcolor=color.black, size=size.small)

if entry_pullbk
    label.new(bar_index, low * 0.995, "ADD  Pullback", style=label.style_label_up,
              color=color.new(color.teal, 10), textcolor=color.white, size=size.tiny)

if exit_signal
    label.new(bar_index, high * 1.005, stage4 ? "EXIT  Stage 4" : "EXIT  EMA50 Break",
              style=label.style_label_down, color=color.new(color.red, 10),
              textcolor=color.white, size=size.small)

// ── Dashboard Table ───────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 12,
                        border_width=1, border_color=color.new(color.gray, 50),
                        bgcolor=color.new(color.black, 10))

f_cell(col, row, txt, bg) =>
    table.cell(t, col, row, txt, text_color=color.white, text_size=size.small, bgcolor=bg)

if barstate.islast
    f_cell(0, 0, "QQQ SWING SUITE", c_hd)
    f_cell(1, 0, "",                c_hd)
    f_cell(0, 1, "Trend Template",  c_na)
    f_cell(1, 1, str.tostring(tt_score) + "/7", tt_score >= 6 ? c_ok : tt_score >= 4 ? c_na : c_no)
    f_cell(0, 2, "Stage",           c_na)
    f_cell(1, 2, stage2 ? "2 — Bull" : stage4 ? "4 — Bear" : "1/3 — Neutral", stage2 ? c_ok : stage4 ? c_no : c_na)
    f_cell(0, 3, "VCP Tight",       c_na)
    f_cell(1, 3, vcp_ok ? "Yes" : "No",         vcp_ok    ? c_ok : c_na)
    f_cell(0, 4, "MACD Bull",       c_na)
    f_cell(1, 4, macd_bull ? "Yes" : "No",       macd_bull ? c_ok : c_no)
    f_cell(0, 5, "RSI",             c_na)
    f_cell(1, 5, str.tostring(math.round(rsi, 1)), rsi_momentum ? c_ok : rsi_pullback ? c_na : c_no)
    f_cell(0, 6, "Vol Surge",       c_na)
    f_cell(1, 6, vol_surge ? "Yes" : "No",       vol_surge ? c_ok : c_na)
    f_cell(0, 7, "Stop",            c_na)
    f_cell(1, 7, str.tostring(math.round(close - atr * atr_sl, 2)), c_na)
    f_cell(0, 8,  "Target",          c_na)
    f_cell(1, 8,  str.tostring(math.round(close + atr * atr_tp, 2)), c_na)
    f_cell(0, 9,  "Gamma Regime",   c_na)
    f_cell(1, 9,  neg_gamma ? "Negative" : na(vix) ? "N/A" : "Positive",
                  neg_gamma ? c_no : na(vix) ? c_na : c_ok)
    f_cell(0, 10, "OpEx Week",      c_na)
    f_cell(1, 10, is_opex_wk ? "Yes" : "No", is_opex_wk ? color.new(color.orange, 20) : c_na)
    f_cell(0, 11, "Gamma Flip ~",   c_na)
    f_cell(1, 11, "$" + str.tostring(gamma_flip, "#.##"), c_na)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(entry_mom,    "QQQ Momentum Entry",  "QQQ: Momentum entry")
alertcondition(entry_darvas, "QQQ Darvas Breakout", "QQQ: Darvas box breakout")
alertcondition(entry_vcp,    "QQQ VCP Entry",       "QQQ: VCP setup triggered")
alertcondition(entry_pullbk, "QQQ Pullback Add",    "QQQ: Pullback re-entry")
alertcondition(exit_signal,  "QQQ Exit",            "QQQ: Exit signal — EMA50 break or Stage 4")
alertcondition(neg_gamma,    "QQQ Negative Gamma",  "QQQ: VIX above threshold — negative gamma regime, reduce size")
alertcondition(is_opex_wk,   "QQQ OpEx Week",       "QQQ: Monthly options expiration week — expect amplified moves")
